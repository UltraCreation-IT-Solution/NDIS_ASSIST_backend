            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations/{{orgId}}/suspend"
          }
        },
        {
          "name": "POST /api/v1/platform/organizations/:id/activate",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations/{{orgId}}/activate"
          }
        },
        {
          "name": "DELETE /api/v1/platform/organizations/:id",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations/{{orgId}}"
          }
        }
      ]
    },
    {
