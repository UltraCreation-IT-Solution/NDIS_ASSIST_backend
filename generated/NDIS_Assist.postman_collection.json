{
  "info": {
    "name": "NDIS Assist API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Auto-generated collection for quick testing. Set baseUrl, apiPrefix, and auth tokens in variables."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiPrefix", "value": "/api/v1" },
    { "key": "authToken", "value": "" },
    { "key": "platformToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Platform",
      "item": [
        {
          "name": "GET /api/v1/platform/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPrefix}}/platform/health"
          }
        },
        {
          "name": "POST /api/v1/platform/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/auth/login"
          }
        },
        {
          "name": "GET /api/v1/platform/auth/me",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/auth/me"
          }
        },
        {
          "name": "POST /api/v1/platform/auth/logout",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/auth/logout"
          }
        },
        {
          "name": "POST /api/v1/platform/auth/logout-all",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/auth/logout-all"
          }
        }
      ]
    },
    {
      "name": "Platform Organizations",
      "item": [
        {
          "name": "GET /api/v1/platform/organizations",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations"
          }
        },
        {
          "name": "GET /api/v1/platform/organizations/stats",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations/stats"
          }
        },
        {
          "name": "GET /api/v1/platform/organizations/:id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations/{{orgId}}"
          }
        },
        {
          "name": "POST /api/v1/platform/organizations",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}{{apiPrefix}}/platform/organizations"
          }
        },
        {
          "name": "PATCH /api/v1/platform/organizations/:id",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
