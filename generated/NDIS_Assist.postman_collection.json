        },
        {
          "name": "POST /api/v1/auth/change-password",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/change-password"
          }
        },
        {
          "name": "GET /api/v1/auth/sessions",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{authToken}}" }] },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/sessions"
          }
        }
      ]
    }
  ]
}
