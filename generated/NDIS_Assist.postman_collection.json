          }
        },
        {
          "name": "POST /api/v1/platform/organizations/:id/suspend",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{platformToken}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
