model Client {
  id                   String                @id @default(cuid())
  organizationId       String                @map("organization_id")
  userId               String?               @unique @map("user_id")
  firstName            String                @map("first_name")
  lastName             String                @map("last_name")
  preferredName        String?               @map("preferred_name")
  dateOfBirth          DateTime              @map("date_of_birth")
  gender               String?
  phone                String?
  email                String?
  address              String?
  suburb               String?
  state                String?
  postcode             String?
  ndisNumber           String?               @map("ndis_number")
  ndisPlanStartDate    DateTime?             @map("ndis_plan_start_date")
  ndisPlanEndDate      DateTime?             @map("ndis_plan_end_date")
  ndisPlanManager      String?               @map("ndis_plan_manager")
  ndisPlanManagerEmail String?               @map("ndis_plan_manager_email")
  ndisPlanManagerPhone String?               @map("ndis_plan_manager_phone")
  hasAgedCare          Boolean               @default(false) @map("has_aged_care")
  agedCarePackageLevel AgedCarePackageLevel? @map("aged_care_package_level")
  agedCareReferenceNo  String?               @map("aged_care_reference_no")
  clientTypeId         String?               @map("client_type_id")
  languageId           String?               @map("language_id")
  status               ClientStatus          @default(ACTIVE)
  onboardedAt          DateTime?             @map("onboarded_at")
  dischargedAt         DateTime?             @map("discharged_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fundingSources    ClientFundingSource[]
  budgetLines       ClientBudgetLine[]
  goals             ClientGoal[]
  assessments       ClientAssessment[]
  carePlans         ClientCarePlan[]
  familyMembers     ClientFamilyMember[]
  documents         ClientDocument[]
  notes             ClientNote[]
  serviceAgreements ClientServiceAgreement[]
  shifts            Shift[]
  recurringShifts   RecurringShiftPattern[]
  invoices          Invoice[]
  payments          Payment[]
  creditNotes       CreditNote[]
  incidents         Incident[]
  complaints        Complaint[]
  formSubmissions   FormSubmission[]

  @@unique([organizationId, ndisNumber])
  @@index([organizationId])
  @@index([status])
  @@map("clients")
}

model ClientFundingSource {
  id              String      @id @default(cuid())
  clientId        String      @map("client_id")
  fundingType     FundingType @map("funding_type")
  planNumber      String?     @map("plan_number")
  totalBudget     Decimal     @map("total_budget") @db.Decimal(12, 2)
  spentAmount     Decimal     @default(0) @map("spent_amount") @db.Decimal(12, 2)
  remainingAmount Decimal     @map("remaining_amount") @db.Decimal(12, 2)
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budgetLines ClientBudgetLine[]

  @@index([clientId])
  @@map("client_funding_sources")
}

model ClientBudgetLine {
  id              String             @id @default(cuid())
  clientId        String             @map("client_id")
  fundingSourceId String             @map("funding_source_id")
  category        NdisBudgetCategory
  supportItemNo   String?            @map("support_item_no")
  description     String?
  allocatedAmount Decimal            @map("allocated_amount") @db.Decimal(12, 2)
  usedAmount      Decimal            @default(0) @map("used_amount") @db.Decimal(12, 2)
  remainingAmount Decimal            @map("remaining_amount") @db.Decimal(12, 2)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fundingSource ClientFundingSource @relation(fields: [fundingSourceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_budget_lines")
}

model ClientGoal {
  id                 String     @id @default(cuid())
  clientId           String     @map("client_id")
  goalTitle          String     @map("goal_title")
  description        String?
  ndisDomain         String?    @map("ndis_domain")
  status             GoalStatus @default(NOT_STARTED)
  progressPercentage Int        @default(0) @map("progress_percentage")
  targetDate         DateTime?  @map("target_date")
  achievedDate       DateTime?  @map("achieved_date")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  client     Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones ClientGoalMilestone[]

  @@index([clientId])
  @@map("client_goals")
}

model ClientGoalMilestone {
  id          String    @id @default(cuid())
  goalId      String    @map("goal_id")
  title       String
  description String?
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  evidence    String?
  createdAt   DateTime  @default(now()) @map("created_at")

  goal ClientGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("client_goal_milestones")
}

model ClientAssessment {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  assessmentType  AssessmentType @map("assessment_type")
  assessmentDate  DateTime       @map("assessment_date")
  assessorName    String?        @map("assessor_name")
  findings        String?
  recommendations String?
  riskLevel       Severity?      @map("risk_level")
  attachmentUrl   String?        @map("attachment_url")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_assessments")
}

model ClientCarePlan {
  id        String         @id @default(cuid())
  clientId  String         @map("client_id")
  planType  String         @map("plan_type")
  title     String
  startDate DateTime       @map("start_date")
  endDate   DateTime?      @map("end_date")
  status    CarePlanStatus @default(DRAFT)
  content   Json?
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_care_plans")
}

model ClientFamilyMember {
  id                 String   @id @default(cuid())
  clientId           String   @map("client_id")
  userId             String?  @map("user_id")
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  relationship       String
  phone              String?
  email              String?
  isEmergencyContact Boolean  @default(false) @map("is_emergency_contact")
  isPrimaryContact   Boolean  @default(false) @map("is_primary_contact")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("client_family_members")
}

model ClientDocument {
  id           String         @id @default(cuid())
  clientId     String         @map("client_id")
  categoryId   String?        @map("category_id")
  documentType String         @map("document_type")
  title        String
  fileName     String         @map("file_name")
  fileUrl      String         @map("file_url")
  fileSize     Int?           @map("file_size")
  expiryDate   DateTime?      @map("expiry_date")
  status       DocumentStatus @default(ACTIVE)
