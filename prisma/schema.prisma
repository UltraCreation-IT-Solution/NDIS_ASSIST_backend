  rate           Decimal  @db.Decimal(8, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("allowance_configs")
}

model Invoice {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  clientId        String          @map("client_id")
  invoiceNumber   String          @map("invoice_number")
  invoiceDate     DateTime        @map("invoice_date")
  dueDate         DateTime?       @map("due_date")
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal         @default(0) @map("gst_amount") @db.Decimal(10, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal         @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status          InvoiceStatus   @default(DRAFT)
  isNdisInvoice   Boolean         @default(false) @map("is_ndis_invoice")
  notes           String?
  xeroInvoiceId   String?         @map("xero_invoice_id")
  xeroSyncStatus  XeroSyncStatus? @map("xero_sync_status")
  xeroSyncedAt    DateTime?       @map("xero_synced_at")
  xeroSyncError   String?         @map("xero_sync_error")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems    InvoiceLineItem[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id            String    @id @default(cuid())
  invoiceId     String    @map("invoice_id")
  shiftId       String?   @map("shift_id")
  supportItemNo String?   @map("support_item_no")
  description   String
  date          DateTime?
  quantity      Decimal   @db.Decimal(8, 2)
  unitPrice     Decimal   @map("unit_price") @db.Decimal(8, 2)
  gstAmount     Decimal   @default(0) @map("gst_amount") @db.Decimal(8, 2)
  total         Decimal   @db.Decimal(10, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String        @map("organization_id")
  invoiceId       String        @map("invoice_id")
  clientId        String        @map("client_id")
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  status          PaymentStatus @default(PENDING)
  paymentDate     DateTime      @map("payment_date")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

model CreditNote {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  invoiceId      String           @map("invoice_id")
  clientId       String           @map("client_id")
  creditNumber   String           @map("credit_number")
  amount         Decimal          @db.Decimal(12, 2)
  reason         String?
  status         CreditNoteStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, creditNumber])
  @@map("credit_notes")
}

model XeroConnection {
  id             String    @id @default(cuid())
  organizationId String    @unique @map("organization_id")
  xeroTenantId   String    @map("xero_tenant_id")
  xeroTenantName String?   @map("xero_tenant_name")
  accessToken    String    @map("access_token")
  refreshToken   String    @map("refresh_token")
  tokenExpiresAt DateTime  @map("token_expires_at")
  scopes         String?
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncAt     DateTime? @map("last_sync_at")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("xero_connections")
}


// ============================================================================
// LAYER 3E: INCIDENTS & COMPLAINTS
// ============================================================================

model Incident {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  incidentNumber   String         @map("incident_number")
  clientId         String?        @map("client_id")
  staffId          String?        @map("staff_id")
  reportedById     String?        @map("reported_by")
  incidentType     IncidentType   @map("incident_type")
  severity         Severity
  description      String
  location         String?
  dateOccurred     DateTime       @map("date_occurred")
  dateReported     DateTime       @default(now()) @map("date_reported")
  status           IncidentStatus @default(OPEN)
  isNdisReportable Boolean        @default(false) @map("is_ndis_reportable")
  ndisReportedAt   DateTime?      @map("ndis_reported_at")
  ndisReferenceNo  String?        @map("ndis_reference_no")
  resolution       String?
  resolvedAt       DateTime?      @map("resolved_at")
  attachments      Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staff        StaffMember?       @relation("StaffIncident", fields: [staffId], references: [id], onDelete: SetNull)
  reportedBy   User?              @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  followUps    IncidentFollowUp[]

  @@unique([organizationId, incidentNumber])
  @@index([organizationId])
  @@map("incidents")
}

model IncidentFollowUp {
  id          String    @id @default(cuid())
  incidentId  String    @map("incident_id")
  action      String
  assignedTo  String?   @map("assigned_to")
  dueDate     DateTime  @map("due_date")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_follow_ups")
}

model Complaint {
  id                 String          @id @default(cuid())
  organizationId     String          @map("organization_id")
  complaintNumber    String          @map("complaint_number")
  clientId           String?         @map("client_id")
  complaintType      ComplaintType   @map("complaint_type")
  subject            String
  description        String
  reportedById       String?         @map("filed_by")
  complainantName    String?         @map("complainant_name")
  complainantContact String?         @map("complainant_contact")
  desiredOutcome     String?         @map("desired_outcome")
  investigation      String?
  assignedTo         String?         @map("assigned_to")
  status             ComplaintStatus @default(OPEN)
  resolution         String?
  resolvedAt         DateTime?       @map("resolved_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reportedBy   User?        @relation("ComplaintReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, complaintNumber])
  @@index([organizationId])
  @@map("complaints")
}


// ============================================================================
// LAYER 3F: COMMUNICATION
// ============================================================================

model Message {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  senderId        String    @map("sender_id")
  recipientId     String    @map("recipient_id")
  parentMessageId String?   @map("parent_message_id")
  subject         String?
  body            String
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([recipientId, isRead])
  @@map("messages")
}

model Announcement {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  createdById    String               @map("created_by_id")
  title          String
  content        String
  priority       AnnouncementPriority @default(NORMAL)
  targetRoles    String[]             @map("target_roles")
  isActive       Boolean              @default(true) @map("is_active")
  publishAt      DateTime?            @map("publish_at")
  expiresAt      DateTime?            @map("expires_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("announcements")
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  userId         String              @map("user_id")
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String?
  message        String
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at")
  actionUrl      String?             @map("action_url")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model EmailLog {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  toEmail        String      @map("to_email")
  fromEmail      String?     @map("from_email")
  subject        String
  templateId     String?     @map("template_id")
  status         EmailStatus @default(QUEUED)
  sentAt         DateTime?   @map("sent_at")
  errorMessage   String?     @map("error_message")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("email_logs")
}

model SmsLog {
  id             String    @id @default(cuid())
  organizationId String?   @map("organization_id")
  toPhone        String    @map("to_phone")
  body           String
  status         SmsStatus @default(QUEUED)
  sentAt         DateTime? @map("sent_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sms_logs")
}


// ============================================================================
// LAYER 3G: FORM BUILDER
// ============================================================================

model FormTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  createdById    String?  @map("created_by")
  name           String
  description    String?
  category       String
  isActive       Boolean  @default(true) @map("is_active")
  isPublished    Boolean  @default(false) @map("is_published")
  isSystemForm   Boolean  @default(false) @map("is_system_form")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User?            @relation("FormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fields        FormField[]
  submissions   FormSubmission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("form_templates")
}

model FormField {
  id           String        @id @default(cuid())
  templateId   String        @map("template_id")
  fieldName    String        @map("field_name")
  label        String
  fieldType    FormFieldType @map("field_type")
  isRequired   Boolean       @default(false) @map("is_required")
  placeholder  String?
  helpText     String?       @map("help_text")
  defaultValue String?       @map("default_value")
  options      String[]
  validation   Json?
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("form_fields")
}

model FormSubmission {
  id            String               @id @default(cuid())
  templateId    String               @map("template_id")
  submittedById String               @map("submitted_by")
  clientId      String?              @map("client_id")
  staffId       String?              @map("staff_id")
  shiftId       String?              @map("shift_id")
  data          Json
  status        FormSubmissionStatus @default(DRAFT)
  submittedAt   DateTime?            @map("submitted_at")
  reviewedBy    String?              @map("reviewed_by")
  reviewedAt    DateTime?            @map("reviewed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  template        FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submittedByUser User         @relation("FormSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staff           StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("form_submissions")
}


// ============================================================================
// LAYER 3H: ORG DOCUMENTS
// ============================================================================

model DocumentCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    OrgDocument[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("document_categories")
}

model OrgDocument {
  id                String         @id @default(cuid())
  organizationId    String         @map("organization_id")
  categoryId        String?        @map("category_id")
  uploadedById      String?        @map("uploaded_by")
  title             String
  description       String?
  fileName          String         @map("file_name")
  fileUrl           String         @map("file_url")
  fileType          String?        @map("file_type")
  fileSize          Int?           @map("file_size")
  expiryDate        DateTime?      @map("expiry_date")
  requiresSignature Boolean        @default(false) @map("requires_signature")
  visibleToRoles    String[]       @map("visible_to_roles")
  version           Int            @default(1)
  status            DocumentStatus @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     DocumentCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy   User?                 @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  signatures   DocumentSignature[]
  versions     OrgDocumentVersion[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("org_documents")
}

model DocumentSignature {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  signedById   String   @map("signed_by_id")
  signatureUrl String?  @map("signature_url")
  signedAt     DateTime @default(now()) @map("signed_at")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  document OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signedBy User        @relation("DocSigner", fields: [signedById], references: [id], onDelete: Cascade)

  @@unique([documentId, signedById])
  @@index([documentId])
  @@map("document_signatures")
}

model OrgDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String   @map("document_id")
  versionNumber Int      @map("version_number")
  fileUrl       String   @map("file_url")
  changeNotes   String?  @map("change_notes")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  document OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@map("org_document_versions")
}


// ============================================================================
// LAYER 3I: KPIs & REPORTS
// ============================================================================

model KpiDefinition {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  metric         String
  targetValue    Decimal? @map("target_value") @db.Decimal(10, 2)
  unit           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       KpiValue[]

  @@index([organizationId])
  @@map("kpi_definitions")
}

model KpiValue {
  id          String   @id @default(cuid())
  kpiId       String   @map("kpi_id")
  staffId     String?  @map("staff_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  actualValue Decimal  @map("actual_value") @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  kpi   KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  staff StaffMember?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([kpiId])
  @@map("kpi_values")
}

model ScheduledReport {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  reportName        String            @map("report_name")
  reportType        ReportType        @map("report_type")
  scheduleFrequency ScheduleFrequency @map("schedule_frequency")
  recipientEmails   String[]          @map("recipient_emails")
  parameters        Json?
  isActive          Boolean           @default(true) @map("is_active")
  lastRunAt         DateTime?         @map("last_run_at")
  nextRunAt         DateTime?         @map("next_run_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedReports GeneratedReport[]

  @@index([organizationId])
  @@map("scheduled_reports")
}

model GeneratedReport {
  id                String   @id @default(cuid())
  scheduledReportId String   @map("scheduled_report_id")
  fileUrl           String   @map("file_url")
  format            String   @default("pdf")
  fileSize          Int?     @map("file_size")
  generatedAt       DateTime @map("generated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId])
  @@map("generated_reports")
}


// ============================================================================
// LAYER 3J: SYSTEM & MASTER DATA
// ============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  description    String?
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  activityType   String   @map("activity_type")
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model SystemLog {
  id          String   @id @default(cuid())
  logLevel    LogLevel @map("log_level")
  message     String
  serviceName String   @map("service_name")
  stackTrace  String?  @map("stack_trace")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([logLevel])
  @@index([createdAt])
  @@map("system_logs")
}

model OrgSetting {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  category       String?
  key            String   @map("setting_key")
  value          String   @map("setting_value")
  updatedById    String?  @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key], map: "org_settings_organization_id_setting_key_key")
  @@map("org_settings")
}

model MasterDataItem {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  category       String
  label          String
  value          String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category, value])
  @@index([organizationId, category])
  @@map("master_data_items")
}
