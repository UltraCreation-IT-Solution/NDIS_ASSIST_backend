// ============================================================================
// LAYER 3C: SCHEDULING & TIME TRACKING
// ============================================================================

model ServiceType {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  serviceCode    String   @map("service_code")
  serviceName    String   @map("service_name")
  description    String?
  supportItemNo  String?  @map("support_item_no")
  fundingSource  String?  @map("funding_source")
  defaultRate    Decimal  @map("default_rate") @db.Decimal(8, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts       Shift[]

  @@unique([organizationId, serviceCode])
  @@map("service_types")
}

model Shift {
  id                 String      @id @default(cuid())
  organizationId     String      @map("organization_id")
  clientId           String      @map("client_id")
  staffId            String?     @map("staff_id")
  serviceTypeId      String      @map("service_type_id")
  shiftTypeId        String?     @map("shift_type_id")
  scheduledStart     DateTime    @map("scheduled_start")
  scheduledEnd       DateTime    @map("scheduled_end")
  actualStart        DateTime?   @map("actual_start")
  actualEnd          DateTime?   @map("actual_end")
  rateType           RateType    @default(WEEKDAY_DAY) @map("rate_type")
  hourlyRate         Decimal?    @map("hourly_rate") @db.Decimal(8, 2)
  totalHours         Decimal?    @map("total_hours") @db.Decimal(6, 2)
  breakMinutes       Int         @default(0) @map("break_minutes")
  travelKm           Decimal?    @map("travel_km") @db.Decimal(8, 2)
  totalAmount        Decimal?    @map("total_amount") @db.Decimal(10, 2)
  status             ShiftStatus @default(DRAFT)
  notes              String?
  cancellationReason String?     @map("cancellation_reason")
  isGroupShift       Boolean     @default(false) @map("is_group_shift")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff         StaffMember?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  serviceType   ServiceType         @relation(fields: [serviceTypeId], references: [id])
  progressNotes ShiftProgressNote[]
  clockEvents   ClockEvent[]
  lineItems     InvoiceLineItem[]
  swaps         ShiftSwap[]

  @@index([organizationId])
  @@index([clientId])
  @@index([staffId])
  @@index([scheduledStart, scheduledEnd])
  @@index([status])
  @@map("shifts")
}

model RecurringShiftPattern {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  clientId       String         @map("client_id")
  staffId        String?        @map("staff_id")
  recurrenceType RecurrenceType @map("recurrence_type")
  daysOfWeek     DayOfWeek[]    @map("days_of_week")
  startTime      String         @map("start_time")
  endTime        String         @map("end_time")
  effectiveFrom  DateTime       @map("effective_from")
  effectiveTo    DateTime?      @map("effective_to")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("recurring_shift_patterns")
}

model ShiftProgressNote {
  id                  String      @id @default(cuid())
  shiftId             String      @map("shift_id")
  activitiesPerformed String      @map("activities_performed")
  clientMood          ClientMood? @map("client_mood")
  clientResponse      String?     @map("client_response")
  goalsAddressed      String?     @map("goals_addressed")
  followUpRequired    Boolean     @default(false) @map("follow_up_required")
  followUpDetails     String?     @map("follow_up_details")
  attachments         Json?
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("shift_progress_notes")
}

model ShiftSwap {
  id              String     @id @default(cuid())
  shiftId         String     @map("shift_id")
  originalStaffId String     @map("original_staff_id")
  newStaffId      String     @map("new_staff_id")
  reason          String?
  status          SwapStatus @default(PENDING)
  reviewedBy      String?    @map("reviewed_by")
  reviewedAt      DateTime?  @map("reviewed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  shift         Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  originalStaff StaffMember @relation("OriginalStaff", fields: [originalStaffId], references: [id])
  newStaff      StaffMember @relation("NewStaff", fields: [newStaffId], references: [id])

  @@index([shiftId])
  @@map("shift_swaps")
}

model ClockEvent {
  id               String      @id @default(cuid())
  shiftId          String      @map("shift_id")
  staffId          String      @map("staff_id")
  action           ClockAction
  timestamp        DateTime
  latitude         Decimal?    @db.Decimal(10, 7)
  longitude        Decimal?    @db.Decimal(10, 7)
  accuracy         Decimal?    @db.Decimal(8, 2)
  address          String?
  isWithinGeofence Boolean?    @map("is_within_geofence")
  photoUrl         String?     @map("photo_url")
  deviceInfo       String?     @map("device_info")
  createdAt        DateTime    @default(now()) @map("created_at")

  shift Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([staffId])
  @@map("clock_events")
}

model Geofence {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  radiusMeters   Int      @map("radius_meters")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("geofences")
}

model StaffLocationLog {
  id        String   @id @default(cuid())
  staffId   String   @map("staff_id")
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  accuracy  Decimal? @db.Decimal(8, 2)
  speed     Decimal? @db.Decimal(6, 2)
  timestamp DateTime
  createdAt DateTime @default(now()) @map("created_at")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([timestamp])
  @@map("staff_location_logs")
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  holidayName    String   @map("holiday_name")
  holidayDate    DateTime @map("holiday_date")
  state          String?
  isNational     Boolean  @default(false) @map("is_national")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, holidayDate, state])
  @@map("public_holidays")
}


