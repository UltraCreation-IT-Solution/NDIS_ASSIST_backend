  registrationGroup   String?   @map("registration_group")
  supportCategory     String?   @map("support_category")
  unit                String?
  priceWeekday        Decimal   @map("price_weekday") @db.Decimal(8, 2)
  priceWeekdayEvening Decimal?  @map("price_weekday_evening") @db.Decimal(8, 2)
  priceWeekdayNight   Decimal?  @map("price_weekday_night") @db.Decimal(8, 2)
  priceSaturday       Decimal?  @map("price_saturday") @db.Decimal(8, 2)
  priceSunday         Decimal?  @map("price_sunday") @db.Decimal(8, 2)
  pricePublicHoliday  Decimal?  @map("price_public_holiday") @db.Decimal(8, 2)
  isActive            Boolean   @default(true) @map("is_active")
  effectiveFrom       DateTime  @map("effective_from")
  effectiveTo         DateTime? @map("effective_to")
  createdAt           DateTime  @default(now()) @map("created_at")
